    "What Should This Group Call You?": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你喺呢個群組叫咩名"
          }
        }
      }
    },
    "What was it for?": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "買咗乜"
          }
        }
      }
    },
    "Which one are you?": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你係邊個"
          }
        }
      }
    },
    "Who Shares It": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "邊啲人有份"
          }
        }
      }
    },
    "Within budget · %@ left": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "預算內 · 仲剩 %@"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有"
          }
        }
      }
    },
    "You": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "You can add the date later, but a Proposal can only be chosen once there is one.": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "未定日期都開得，不過要有日期先可以選定提案。"
          }
        }
      }
    },
    "You get back %@": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你攞返 %@"
          }
        }
      }
    },
    "You have left": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你仲剩"
          }
        }
      }
    },
    "You owe %@": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你要畀 %@"
          }
        }
      }
    },
    "You pay %@ %@": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你要畀 %1$@ %2$@"
          }
        }
      }
    },
    "You: %@ left": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你：仲剩 %@"
          }
        }
      }
    },
    "You: over by %@": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你：超支 %@"
          }
        }
      }
    },
    "Your Balance in This Group": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你喺呢個群組"
          }
        }
      }
    },
    "Your Personal Budget stays on this iPhone. Other Members and SplitLa can’t see it.": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "個人預算只儲喺呢部機，其他成員同 SplitLa 都睇唔到。"
          }
        }
      }
    },
    "Your Shares of Expenses so far, plus your Shares of Chosen Proposals for Activities you’re going to.": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已經發生嘅開支入面你嘅份額，加埋你覆咗「去」嘅活動入面選定提案嘅份額。"
          }
        }
      }
    },
    "Your accounts stay, and other Members still see your Balance. You can come back with the invite link and claim it again.": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你條數會留低，其他成員仍然見到你嘅結餘。你之後可以經邀請連結返嚟認領返。"
          }
        }
      }
    },
    "Your monthly limit for social spending, across all your Groups. It stays on this iPhone: other Members and SplitLa’s servers can’t see it, and nobody can tell whether you go over.": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你每個月社交開支嘅上限，跨晒所有群組。只儲喺呢部機：其他成員同 SplitLa 嘅伺服器都睇唔到，亦唔會知你有冇超支。"
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅名"
          }
        }
      }
    },
    "Your share": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅份額"
          }
        }
      }
    },
    "You’re all square": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經找清"
          }
        }
      }
    },
    "You’re over by": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你超支咗"
          }
        }
      }
    },
    "e.g. Restaurant A": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：餐廳 A"
          }
        }
      }
    },
    "e.g. Saturday hotpot": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：星期六火鍋"
          }
        }
      }
    },
    "e.g. Uni dinner crew": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：大學飯腳"
          }
        }
      }
    },
    "this month": {
      "localizations": {
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今個月"
          }
        }
      }
    }
